# Пример настроек. Скопируйте в config.psd1 (он исключён из git) и заполните по README.md.
# Настоящие адреса и имена серверов банка в репозиторий не коммитить: репозиторий публичный.
@{
    # Сети банка, которые идут напрямую через физический адаптер, мимо TUN Happ:
    # - сеть шлюза NGate (адреса из Resolve-DnsName <имя шлюза>), /24 вокруг них;
    # - сети публичных сервисов банка, которые NGate не маршрутизирует (без Happ они и так шли напрямую).
    #   Признак в diagnose.ps1: адрес «в правиле: да», маршрут через Happ, tcp: err:AccessDenied.
    # Маршруты NGate (/32) точнее этих сетей и остаются в туннеле.
    DirectPrefixes = @(
        '203.0.113.0/24'
        '198.51.100.0/24'
    )

    # Имена, которые разрешаются из hosts, а не через DNS: шлюз NGate (нужен до подъёма туннеля)
    # и ресурсы банка, к которым обращаетесь по имени.
    HostsEntries = @(
        @{ Name = 'ngate-gateway.bank.example'; IPs = @('203.0.113.10', '203.0.113.11') }
        @{ Name = 'resource.bank.example';      IPs = @('198.51.100.21') }
    )

    # Адаптер Happ в режиме TUN (Get-NetAdapter при подключённом Happ).
    TunAdapterName = 'happ-default-tun'

    # Правило брандмауэра: исходящий трафик к этим адресам через адаптер Happ блокируется.
    FirewallRuleName = 'Bank: never via Happ'
    # Сеть шлюза, адреса из маршрутов NGate, DNS банка, подсеть самого VPN.
    BankAddresses = @(
        '203.0.113.0/23'
        '198.51.100.21'
        '10.0.0.53'
        '10.100.0.0/18'
    )
}
